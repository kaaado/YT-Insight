        "            df['sentiment'] = [p['label'] for p in preds]\n",
        "\n",
        "        # 2. Emotion\n",
        "        pipe_e = get_pipeline(\"text-classification\", EMOTION_MODELS['default'])\n",
        "        if pipe_e:\n",
        "            preds = pipe_e(texts, batch_size=32)\n",
        "            df['emotion'] = [p['label'] for p in preds]\n",
        "\n",
        "        # 3. Spam (TinyBERT)\n",
        "        pipe_spam = get_pipeline(\"text-classification\", SPAM_MODEL)\n",
        "        if pipe_spam:\n",
        "            preds = pipe_spam(texts, batch_size=32)\n",
        "            df['is_spam'] = [True if (p['label'] == 'LABEL_1' and p['score'] > 0.8) else False for p in preds]\n",
        "        else: df['is_spam'] = False\n",
        "\n",
        "        # 4. Question\n",
        "        pipe_q = get_pipeline(\"text-classification\", QUESTION_MODEL)\n",
        "        if pipe_q:\n",
        "            print(\"   🚀 Running AI Question Detection...\")\n",
        "            preds = pipe_q(texts, batch_size=32)\n",
        "\n",
        "            # Only mark as question if model is > 90% SURE\n",
        "            df['is_question'] = [True if (p['label'] == 'LABEL_1' and p['score'] > 0.9) else False for p in preds]\n",
        "        else: df['is_question'] = False\n",
        "\n",
        "        # 5. Generative Smart Reply\n",
        "        agent = SmartReplyAgent()\n",
        "        if agent.model:\n",
        "            print(\"   🤖 Generating Unique AI Replies...\")\n",
