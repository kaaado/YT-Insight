        "# 📦 MODULE 3 - AI INFERENCE\n",
        "# ==========================================\n",
        "import os\n",
        "import torch\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import json\n",
        "import glob\n",
        "from tqdm import tqdm\n",
        "from transformers import AutoTokenizer, AutoModelForSequenceClassification, AutoModelForSeq2SeqLM, pipeline\n",
        "\n",
        "# --- CONFIG ---\n",
        "INPUT_PATH = \"data/processed/comments_ready_for_ml.parquet\"\n",
        "OUTPUT_DIR = \"data/predictions\"\n",
        "RAW_DATA_DIR = \"data/raw\"\n",
        "\n",
        "# --- MODEL REGISTRY ---\n",
        "SENTIMENT_MODEL = \"lxyuan/distilbert-base-multilingual-cased-sentiments-student\"\n",
        "EMOTION_MODELS = { \"default\": \"samLowe/roberta-base-go_emotions\" }\n",
        "REPLY_MODEL = \"google/flan-t5-base\"\n",
        "SPAM_MODEL = \"mrm8488/bert-tiny-finetuned-sms-spam-detection\"\n",
        "QUESTION_MODEL = \"shahrukhx01/bert-mini-finetune-question-detection\"\n",
        "\n",
        "class SmartReplyAgent:\n",
        "    def __init__(self):\n",
        "        print(\"   🧠 Initializing Generative Reply Agent (Flan-T5)...\")\n",
        "        self.device = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
        "        try:\n",
        "            self.tokenizer = AutoTokenizer.from_pretrained(REPLY_MODEL)\n",
        "            self.model = AutoModelForSeq2SeqLM.from_pretrained(REPLY_MODEL)\n",
        "            if self.device == \"cuda\": self.model = self.model.to(self.device)\n",
        "        except: self.model = None\n",
        "\n",
        "    def generate_reply(self, text, sentiment=\"neutral\", is_question=False):\n",
        "        # 1. Filter: Skip short/negative/spam comments\n",
        "        if not self.model or len(str(text)) < 3: return \"\"\n",
        "        if sentiment == \"negative\": return \"\"\n",
        "\n",
        "        # BETTER PROMPTS\n",
        "        if is_question:\n",
        "            prompt = f\"Answer this YouTube comment helpfuly: {text}\"\n",
        "        else:\n",
        "            prompt = f\"Write a short, happy reply to this YouTube comment: {text}\"\n",
        "\n",
        "        try:\n",
        "            inputs = self.tokenizer(prompt, return_tensors=\"pt\", truncation=True, max_length=128).to(self.device)\n",
        "            outputs = self.model.generate(\n",
        "                **inputs,\n",
        "                max_length=40, # Keep it short\n",
        "                min_length=3,\n",
        "                do_sample=True,\n",
        "                temperature=0.7\n",
        "            )\n",
        "            return self.tokenizer.decode(outputs[0], skip_special_tokens=True)\n",
        "        except: return \"\"\n",
        "\n",
        "def get_pipeline(task, model_name):\n",
        "    print(f\"   🧠 Loading {task}: {model_name}...\")\n",
        "    try:\n",
        "        tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
        "        model = AutoModelForSequenceClassification.from_pretrained(model_name, low_cpu_mem_usage=False)\n",
        "        if torch.cuda.is_available(): model = model.to(\"cuda\")\n",
        "        # return_all_scores=False gives us the top label and its score\n",
        "        return pipeline(task, model=model, tokenizer=tokenizer, truncation=True, max_length=128)\n",
        "    except: return None\n",
        "\n",
        "def execute_module_3():\n",
        "    try:\n",
        "        print(\"\\n--- 3. MACHINE LEARNING (INFERENCE & AGENT) ---\")\n",
