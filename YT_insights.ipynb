        "# ==========================================\n",
        "# 📦 MODULE 1 - Scraper\n",
        "# ==========================================\n",
        "import os\n",
        "import re\n",
        "import json\n",
        "import time\n",
        "import random\n",
        "import pandas as pd\n",
        "import shutil\n",
        "from googleapiclient.discovery import build\n",
        "from googleapiclient.errors import HttpError\n",
        "\n",
        "# --- CONFIGURATION ---\n",
        "API_KEY = \"Your_api_key"\n",
        "MAX_RESULT = 5000\n",
        "\n",
        "class YouTubeProScraper:\n",
        "    def __init__(self, api_key):\n",
        "        self.youtube = build('youtube', 'v3', developerKey=api_key)\n",
        "        self.quota_used = 0\n",
        "\n",
        "    def _execute_with_retry(self, request, max_retries=5):\n",
        "        for attempt in range(max_retries):\n",
        "            try: return request.execute()\n",
        "            except HttpError as e:\n",
        "                if e.resp.status in [403, 429, 500, 503]:\n",
        "                    time.sleep((2 ** attempt) + random.uniform(0, 1))\n",
        "                else: raise e\n",
        "        raise Exception(\"❌ Max retries exceeded.\")\n",
        "\n",
        "    def extract_video_id(self, url):\n",
        "        match = re.search(r\"(?:v=|\\/)([0-9A-Za-z_-]{11}).*\", url)\n",
        "        if match: return match.group(1)\n",
        "        raise ValueError(\"❌ Invalid YouTube URL.\")\n",
        "\n",
        "    def get_video_metadata(self, video_id):\n",
        "        print(f\"🔍 Fetching metadata for: {video_id}\")\n",
        "        request = self.youtube.videos().list(part=\"snippet,statistics\", id=video_id)\n",
        "        response = self._execute_with_retry(request)\n",
        "        if not response.get('items'): raise ValueError(\"❌ Video not found.\")\n",
        "\n",
        "        item = response['items'][0]\n",
        "        snippet = item.get('snippet', {})\n",
        "        stats = item.get('statistics', {})\n",
        "\n",
        "        return {\n",
        "            \"video_id\": video_id,\n",
        "            \"title\": snippet.get(\"title\"),\n",
        "            \"channel\": snippet.get(\"channelTitle\"),\n",
        "            \"channel_id\": snippet.get(\"channelId\"),\n",
        "            \"language\": snippet.get('defaultAudioLanguage', snippet.get('defaultLanguage', 'unknown')),\n",
        "            \"view_count\": int(stats.get(\"viewCount\", 0)),\n",
        "            \"like_count\": int(stats.get(\"likeCount\", 0)),\n",
        "            \"comment_count\": int(stats.get(\"commentCount\", 0))\n",
        "        }\n",
        "\n",
        "    def get_all_comments(self, video_id, max_results=MAX_RESULT):\n",
        "        print(f\"📥 Starting Scrape (Target: {max_results})...\")\n",
        "        all_comments = []\n",
        "        next_page_token = None\n",
        "\n",
        "        while len(all_comments) < max_results:\n",
        "            request = self.youtube.commentThreads().list(\n",
        "                part=\"snippet,replies\", videoId=video_id, maxResults=100,\n",
        "                pageToken=next_page_token, textFormat=\"plainText\"\n",
        "            )\n",
        "            response = self._execute_with_retry(request)\n",
        "            items = response.get('items', [])\n",
        "            if not items: break\n",
        "\n",
        "            for item in items:\n",
        "                top = item['snippet']['topLevelComment']['snippet']\n",
        "                # Get Commenter's ID\n",
        "                auth_id = top.get('authorChannelId', {}).get('value', 'unknown')\n",
        "\n",
        "                all_comments.append({\n",
        "                    \"comment_id\": item['id'],\n",
        "                    \"text\": top.get('textDisplay', ''),\n",
        "                    \"author\": top.get('authorDisplayName', ''),\n",
        "                    \"author_id\": auth_id,\n",
        "                    \"like_count\": top.get('likeCount', 0),\n",
        "                    \"published_at\": top.get('publishedAt')\n",
        "                })\n",
        "\n",
        "                # Check Replies\n",
        "                if 'replies' in item:\n",
        "                    for rep in item['replies']['comments']:\n",
        "                        r = rep['snippet']\n",
        "                        r_auth_id = r.get('authorChannelId', {}).get('value', 'unknown')\n",
        "                        all_comments.append({\n",
        "                            \"comment_id\": rep['id'],\n",
        "                            \"text\": r.get('textDisplay', ''),\n",
        "                            \"author\": r.get('authorDisplayName', ''),\n",
        "                            \"author_id\": r_auth_id,\n",
        "                            \"like_count\": r.get('likeCount', 0),\n",
        "                            \"published_at\": r.get('publishedAt')\n",
        "                        })\n",
        "\n",
        "            print(f\"   ✅ Fetched {len(all_comments)} comments...\", end='\\r')\n",
        "            next_page_token = response.get('nextPageToken')\n",
        "            if not next_page_token: break\n",
        "\n",
        "        return all_comments[:max_results]\n",
        "\n",
        "def execute_module_1(video_url):\n",
        "    scraper = YouTubeProScraper(API_KEY)\n",
        "    try:\n",
        "        video_id = scraper.extract_video_id(video_url)\n",
        "        meta = scraper.get_video_metadata(video_id)\n",
        "        raw_data = scraper.get_all_comments(video_id, MAX_RESULT)\n",
        "\n",
        "        if not raw_data: return None\n",
        "        df = pd.DataFrame(raw_data)\n",
        "\n",
        "        # Filter Owner by ID (Robust)\n",
        "        owner_id = meta['channel_id']\n",
        "        original_count = len(df)\n",
        "\n",
        "        # Keep comments where author_id is NOT the owner_id\n",
        "        df = df[df['author_id'] != owner_id]\n",
        "\n",
        "        filtered_count = original_count - len(df)\n",
        "        if filtered_count > 0:\n",
        "            print(f\"\\n   🧹 Filtered out {filtered_count} comments from owner (ID: {owner_id})\")\n",
        "\n",
        "        # Cleaning\n",
        "        df['like_count'] = pd.to_numeric(df['like_count']).fillna(0).astype(int)\n",
        "        df['text'] = df['text'].astype(str).fillna(\"\")\n",
        "        df['clean_text'] = df['text'].str.replace(r'\\n', ' ', regex=True).str.strip()\n",
        "\n",
        "        # Table Preview\n",
        "        print(\"\\n👀 DATA PREVIEW (First 5 Rows):\")\n",
        "        pd.set_option('display.max_columns', None)\n",
        "        pd.set_option('display.width', 1000)\n",
        "        pd.set_option('display.max_colwidth', 50)\n",
        "\n",
        "        print(df[['author', 'text', 'like_count']].head(5).to_string(index=False))\n",
        "        print(\"-\" * 50)\n",
        "\n",
        "        os.makedirs('data/raw', exist_ok=True)\n",
        "        with open(f'data/raw/metadata_{video_id}.json', 'w', encoding='utf-8') as f:\n",
        "            json.dump(meta, f, indent=4, default=str, ensure_ascii=False)\n",
        "        df.to_parquet(f'data/raw/comments_{video_id}.parquet', index=False)\n",
        "\n",
        "        print(f\"🎉 MODULE 1 DONE: {len(df)} comments saved.\")\n",
        "        return video_id\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"❌ MODULE 1 ERROR: {e}\")\n",
        "        return None\n"
      ]
    },
