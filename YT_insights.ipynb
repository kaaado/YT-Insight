        "# ==========================================\n",
        "# 📦 MODULE 2 - SPARK ANALYTICS\n",
        "# ==========================================\n",
        "import os, json, re, glob\n",
        "import numpy as np\n",
        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql import functions as F\n",
        "from pyspark.sql.types import StringType, IntegerType\n",
        "from pyspark.ml.feature import RegexTokenizer, StopWordsRemover, CountVectorizer\n",
        "from pyspark.ml.clustering import LDA\n",
        "from pyspark.ml import Pipeline\n",
        "\n",
        "RAW_DATA_DIR = \"data/raw\"\n",
        "OUTPUT_DIR = \"data/analytics\"\n",
        "PROCESSED_DIR = \"data/processed\"\n",
        "\n",
        "def get_stopwords(lang):\n",
        "    if lang == 'ar':\n",
        "        base_words = StopWordsRemover.loadDefaultStopWords(\"arabic\")\n",
        "        new_junk = [\n",
        "            \"رد\", \"ردود\", \"الرد\",\n",
        "            \"فيديو\", \"الفيديو\", \"مقطع\",\n",
        "            \"مشاهدة\", \"شاهد\", \"شاهدت\",\n",
        "            \"يوتيوب\", \"اليوتيوب\",\n",
        "            \"قناة\", \"القناة\",\n",
        "            \"حب\", \"أحب\", \"احب\", \"يحب\",\n",
        "            \"فقط\", \"بس\",\n",
        "            \"لايك\", \"اعجاب\"\n",
        "        ]\n",
        "    else:\n",
        "        base_words = StopWordsRemover.loadDefaultStopWords(\"english\")\n",
        "        new_junk = [\"re\", \"reply\", \"video\", \"watching\", \"youtube\", \"channel\", \"watch\", \"like\", \"love\", \"video\", \"just\"]\n",
        "        return base_words + new_junk\n",
        "\n",
        "def clean_text_factory(lang):\n",
        "    def clean_text_ar(text):\n",
        "        if not text: return \"\"\n",
        "        text = re.sub(r'[\\u064B-\\u065F\\u0640]', '', text)\n",
        "        text = re.sub(r'[أإآ]', 'ا', text)\n",
        "        text = re.sub(r'ة', 'ه', text)\n",
        "        text = re.sub(r'[^\\w\\s\\u0600-\\u06FF]', ' ', text)\n",
        "        return re.sub(r'\\d+', '', text).strip()\n",
        "\n",
        "    def clean_text_general(text):\n",
        "        if not text: return \"\"\n",
        "        text = re.sub(r'[^a-zA-Z\\s]', ' ', text)\n",
        "        return re.sub(r'\\s+', ' ', text).strip().lower()\n",
        "    return clean_text_ar if lang == 'ar' else clean_text_general\n",
        "\n",
        "def execute_module_2(target_video_id=None):\n",
        "    print(\"\\n📊 STARTING MODULE 2...\")\n",
        "    spark = SparkSession.builder.appName(\"YT-Insight\").master(\"local[*]\").config(\"spark.driver.memory\", \"4g\").getOrCreate()\n",
        "    spark.sparkContext.setLogLevel(\"ERROR\")\n",
        "\n",
        "    try:\n",
        "        # Load Data Logic\n",
        "        input_path = f\"{RAW_DATA_DIR}/comments_{target_video_id}.parquet\"\n",
        "        if not os.path.exists(input_path): return None\n",
        "\n",
        "        # Load Metadata\n",
        "        with open(f\"{RAW_DATA_DIR}/metadata_{target_video_id}.json\", 'r') as f:\n",
        "            lang = json.load(f).get('language', 'unknown')\n",
        "\n",
        "        df = spark.read.parquet(input_path).fillna({\"text\": \"\"})\n",
        "        clean_udf = F.udf(clean_text_factory(lang), StringType())\n",
        "        df = df.withColumn(\"clean_text_ml\", clean_udf(F.col(\"text\")))\n",
        "        df_ml = df.filter(F.length(F.trim(F.col(\"clean_text_ml\"))) > 2)\n",
        "\n",
        "        # LDA Pipeline\n",
        "        final_topics = []\n",
        "        if df_ml.count() > 5:\n",
        "            tokenizer = RegexTokenizer(inputCol=\"clean_text_ml\", outputCol=\"tokens\", pattern=\"\\\\s+\")\n",
        "            remover = StopWordsRemover(inputCol=\"tokens\", outputCol=\"filtered_tokens\", stopWords=get_stopwords(lang))\n",
        "            cv = CountVectorizer(inputCol=\"filtered_tokens\", outputCol=\"features\", vocabSize=5000, minDF=1.0)\n",
        "            pipeline = Pipeline(stages=[tokenizer, remover, cv])\n",
        "            model_prep = pipeline.fit(df_ml)\n",
        "            df_transformed = model_prep.transform(df_ml)\n",
        "\n",
        "            lda = LDA(k=3, maxIter=20, featuresCol=\"features\", seed=42)\n",
        "            model = lda.fit(df_transformed)\n",
        "            topics = model.describeTopics(8)\n",
        "            vocab = model_prep.stages[-1].vocabulary\n",
        "\n",
        "            for row in topics.collect():\n",
        "                words = [vocab[i] for i in row['termIndices']]\n",
        "                final_topics.append({\"topic_id\": row['topic'], \"words\": words})\n",
        "\n",
        "            predictions = model.transform(df_transformed)\n",
        "            max_udf = F.udf(lambda v: int(np.argmax(v)), IntegerType())\n",
        "            df_transformed = predictions.withColumn(\"dominant_topic\", max_udf(F.col(\"topicDistribution\")))\n",
        "        else:\n",
        "            df_transformed = df_ml.withColumn(\"dominant_topic\", F.lit(-1))\n",
        "\n",
        "        # Save\n",
        "        os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
        "        os.makedirs(PROCESSED_DIR, exist_ok=True)\n",
        "        with open(f\"{OUTPUT_DIR}/topics_{target_video_id}.json\", 'w', encoding='utf-8') as f:\n",
        "            json.dump(final_topics, f, indent=2)\n",
        "\n",
        "        df_transformed.drop(\"features\", \"tokens\", \"filtered_tokens\", \"topicDistribution\").write.mode(\"overwrite\").parquet(f\"{PROCESSED_DIR}/comments_ready_for_ml.parquet\")\n",
        "        print(f\"✅ MODULE 2 COMPLETE.\")\n",
        "        return target_video_id\n",
        "    except Exception as e:\n",
        "        print(f\"❌ MODULE 2 ERROR: {e}\")\n",
        "        return None\n"
      ]
