      "source": [
        "# ==========================================\n",
        "# 📊 MODULE 5 - DASHBOARD\n",
        "# ==========================================\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import json\n",
        "import os\n",
        "import glob\n",
        "import numpy as np\n",
        "import shutil\n",
        "import nltk\n",
        "from nltk.corpus import stopwords\n",
        "from wordcloud import WordCloud\n",
        "import warnings\n",
        "from IPython.display import display, Markdown\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "# --- 1. SETUP RESOURCES ---\n",
        "def initialize_resources_console():\n",
        "    print(\"\\n📦 [SETUP] Checking NLP Resources...\")\n",
        "    for res in ['stopwords', 'punkt', 'wordnet', 'omw-1.4']:\n",
        "        try: nltk.data.find(f'corpora/{res}')\n",
        "        except LookupError: nltk.download(res, quiet=True)\n",
        "    print(\"   ✅ Resources Ready.\\n\")\n",
        "\n",
        "# --- 2. CREATOR STRATEGY REPORT ---\n",
        "def print_creator_report(df, topics, meta):\n",
        "    print(\"\\n\" + \"█\"*80)\n",
        "    print(f\"📢 CREATOR STRATEGY REPORT: {meta.get('title', 'Unknown')[:50]}...\")\n",
        "    print(\"█\"*80 + \"\\n\")\n",
        "\n",
        "        # 0. TOP 3 TOPICS OVERVIEW\n",
        "    print(\"0️  TOP TOPICS OVERVIEW (0, 1, 2)\")\n",
        "\n",
        "    if topics and 'dominant_topic' in df.columns:\n",
        "        print(\"   • Extracting topic popularity and keywords...\\n\")\n",
        "\n",
        "        # Topic frequency\n",
        "        topic_counts = df['dominant_topic'].value_counts().sort_index()\n",
        "\n",
        "        selected_topics = [t for t in topics if t['topic_id'] in [0, 1, 2]]\n",
        "\n",
        "        for t in selected_topics:\n",
        "            tid = t['topic_id']\n",
        "            words = \", \".join(t['words'][:5])\n",
        "            count = int(topic_counts.get(tid, 0))\n",
        "            pct = (count / len(df)) * 100\n",
        "\n",
        "            print(f\"   🔹 Topic {tid}: {words}\")\n",
        "            print(f\"      • Frequency: {count} comments ({pct:.1f}%)\")\n",
        "            if pct > 20:\n",
        "                print(\"      • Insight: 🚀 Dominant theme — highly discussed.\\n\")\n",
        "            elif pct > 10:\n",
        "                print(\"      • Insight: 👍 Strong presence in discussions.\\n\")\n",
        "            else:\n",
        "                print(\"      • Insight: 👀 Mentioned but not dominant.\\n\")\n",
        "    else:\n",
        "        print(\"   • Topics not available.\\n\")\n",
        "\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 1. THE VIBE CHECK (Sentiment & Intensity)\n",
        "    print(\"1️⃣  THE VIBE CHECK\")\n",
        "    if 'sentiment' in df.columns and 'emotion' in df.columns:\n",
        "        pos = len(df[df['sentiment']=='positive'])\n",
        "        neg = len(df[df['sentiment']=='negative'])\n",
        "        ratio = pos / (neg + 1)\n",
        "        dom_emotion = df['emotion'].mode()[0]\n",
        "        print(f\"   • Mood Score: {ratio:.1f}x more positive than negative.\")\n",
        "        print(f\"   • Dominant Emotion: {dom_emotion.upper()}\")\n",
        "        if ratio > 5: print(\"   • Verdict: 🌟 The audience LOVES this!\")\n",
        "        elif ratio < 1: print(\"   • Verdict: ⚠️ Controversial or negative reception.\")\n",
        "        else: print(\"   • Verdict: ⚖️ Balanced/Neutral feedback.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 2. CONTENT GAPS (Questions)\n",
        "    print(\"2️⃣  BURNING QUESTIONS (Content Ideas)\")\n",
        "    if 'is_question' in df.columns:\n",
        "        questions = df[df['is_question'] == 1]['text'].tolist()\n",
        "        print(f\"   • Found {len(questions)} questions from viewers.\")\n",
        "        print(\"   • Top 3 Sample Questions to Answer in next video:\")\n",
        "        for i, q in enumerate(questions[:3]):\n",
        "            print(f\"     {i+1}. \\\"{q[:80]}...\\\"\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 3. THE \"MONEY\" TOPIC (Engagement)\n",
        "    print(\"3️⃣  THE 'MONEY' TOPIC (Highest Engagement)\")\n",
        "    if 'dominant_topic' in df.columns and 'like_count' in df.columns and topics:\n",
        "        topic_likes = df.groupby('dominant_topic')['like_count'].mean()\n",
        "        best_topic_id = topic_likes.idxmax()\n",
        "        best_topic_name = next((\", \".join(t['words'][:3]) for t in topics if t['topic_id'] == best_topic_id), \"Unknown\")\n",
        "        print(f\"   • Most Liked Topic: #{best_topic_id} ({best_topic_name})\")\n",
        "        print(f\"   • Avg Likes per comment in this topic: {topic_likes.max():.1f}\")\n",
        "        print(\"   • Strategy: Make more content about this specific subject!\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 4. SUPERFAN SPOTLIGHT\n",
        "    print(\"4️⃣  SUPERFAN SPOTLIGHT\")\n",
        "    if 'author' in df.columns:\n",
        "        top_user = df['author'].value_counts().idxmax()\n",
        "        count = df['author'].value_counts().max()\n",
        "        print(f\"   • Top Commenter: {top_user} ({count} comments)\")\n",
        "        print(\"   • Action: Pin their comment or shout them out to build loyalty.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 5. TROLL / SPAM RADAR\n",
        "    print(\"5️⃣  MODERATION RADAR\")\n",
        "    if 'is_spam' in df.columns:\n",
        "        spam_count = df['is_spam'].sum()\n",
        "        pct = (spam_count / len(df)) * 100\n",
        "        print(f\"   • Potential Spam: {spam_count} comments ({pct:.1f}%)\")\n",
        "        if pct > 5: print(\"   • Alert: 🚨 High spam level! Check your filter settings.\")\n",
        "        else: print(\"   • Status: ✅ Clean comment section.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 6. SEO KEYWORDS\n",
        "    print(\"6️⃣  SEO KEYWORDS (For Description/Tags)\")\n",
        "    if 'clean_text_ml' in df.columns:\n",
        "        # 1. Get all words\n",
        "        all_words = \" \".join(df['clean_text_ml'].astype(str)).split()\n",
        "\n",
        "        # 2. Define AGGRESSIVE stopwords list\n",
        "        eng_stops = set(stopwords.words('english'))\n",
        "        # Add YouTube-specific noise (video, watch, channel...)\n",
        "        custom_noise = {\n",
        "            'video', 'channel', 'watch', 'watching', 'make', 'more', 'this', 'that',\n",
        "            'just', 'your', 'please', 'really', 'love', 'like', 'good', 'great',\n",
        "            'https', 'http', 'com', 'www'\n",
        "        }\n",
        "        all_stops = eng_stops.union(custom_noise)\n",
        "\n",
        "        # 3. Filter: Remove stops AND short words\n",
        "        meaningful_words = [w for w in all_words if w not in all_stops and len(w) > 2]\n",
        "\n",
        "        # 4. Count frequency\n",
        "        common = nltk.FreqDist(meaningful_words).most_common(10)\n",
        "        tags = [w[0] for w in common]\n",
        "\n",
        "        if tags: print(f\"   • Recommended Tags: {', '.join(tags)}\")\n",
        "        else: print(\"   • Not enough unique data for tags.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 7. TIMING OPTIMIZATION\n",
        "    print(\"7️⃣  TIMING OPTIMIZATION\")\n",
        "    if 'published_at' in df.columns:\n",
        "        peak_hour = df['published_at'].dt.hour.mode()[0]\n",
        "        print(f\"   • Peak Activity Hour: {peak_hour}:00 (UTC)\")\n",
        "        print(\"   • Strategy: Post your replies or next video around this time.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 8. CONTROVERSY CHECK\n",
        "    print(\"8️⃣  CONTROVERSY METER\")\n",
        "    if 'emotion' in df.columns:\n",
        "        anger_count = len(df[df['emotion'] == 'anger'])\n",
        "        pct = (anger_count / len(df)) * 100\n",
        "        print(f\"   • Anger/Disapproval Level: {pct:.1f}%\")\n",
        "        if pct > 10: print(\"   • Insight: High controversy. Consider addressing this in a community post.\")\n",
        "        else: print(\"   • Insight: Safe. Content is not triggering negative reactions.\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 9. SMART REPLY QUEUE\n",
        "    print(\"9️⃣  QUICK REPLY OPPORTUNITIES\")\n",
        "    if 'suggested_reply' in df.columns:\n",
        "        opportunities = df[df['suggested_reply'] != \"\"]\n",
        "        print(f\"   • The AI generated {len(opportunities)} draft replies.\")\n",
        "        print(\"   • Example Draft:\")\n",
        "        if not opportunities.empty:\n",
        "            sample = opportunities.iloc[0]\n",
        "            print(f\"     User: \\\"{sample['text'][:50]}...\\\"\")\n",
        "            print(f\"     AI Suggestion: \\\"{sample['suggested_reply']}\\\"\")\n",
        "    else: print(\"   • Data N/A\")\n",
        "    print(\"-\" * 40)\n",
        "\n",
        "    # 10. NEXT VIDEO IDEA\n",
        "    print(\"🔟  AI RECOMMENDATION: NEXT VIDEO IDEA\")\n",
        "    if topics and 'is_question' in df.columns:\n",
        "        # Simple logic: Combine top topic + \"Explained\" or \"Q&A\"\n",
        "        top_topic_words = topics[0]['words'][:3]\n",
        "        print(f\"   • Based on Topic 0 and user questions, try this title:\")\n",
        "        print(f\"   • 🎬 \\\"{top_topic_words[0].title()} {top_topic_words[1].title()} Explained: Q&A Special\\\"\")\n",
        "    else:\n",
        "        print(\"   • 🎬 \\\"Subscriber Q&A Special\\\"\")\n",
        "    print(\"=\"*80 + \"\\n\")\n",
        "\n",
        "# --- 3. DASHBOARD GENERATOR (EXISTING) ---\n",
        "def generate_mega_dashboard(video_id):\n",
        "    # --- LOAD DATA ---\n",
        "    try:\n",
        "        meta_path = f\"data/raw/metadata_{video_id}.json\"\n",
        "        data_path = \"data/predictions/comments_classified.parquet\"\n",
        "\n",
        "        if not os.path.exists(data_path):\n",
        "            print(\"❌ CRITICAL: Data file not found. Run Module 3 first.\")\n",
        "            return\n",
        "        df = pd.read_parquet(data_path)\n",
        "\n",
        "        if os.path.exists(meta_path):\n",
        "            meta = json.load(open(meta_path, 'r', encoding='utf-8'))\n",
        "        else:\n",
        "            meta = {\"title\": \"Unknown\", \"language\": \"unknown\"}\n",
        "\n",
        "        # Robust Topic Loading\n",
        "        topics = []\n",
        "        # Search both analytics and predictions folders\n",
        "        possible_paths = [\n",
        "            f\"data/analytics/topics_{video_id}.json\",\n",
        "            f\"data/predictions/topics_{video_id}.json\"\n",
        "        ]\n",
        "        topic_path = None\n",
        "        for path in possible_paths:\n",
        "            if os.path.exists(path):\n",
        "                topic_path = path\n",
        "                break\n",
        "\n",
        "        if not topic_path:\n",
        "            # Fallback search\n",
        "            all_jsons = glob.glob(\"data/analytics/topics_*.json\") + glob.glob(\"data/predictions/topics_*.json\")\n",
        "            if all_jsons: topic_path = max(all_jsons, key=os.path.getctime)\n",
        "\n",
        "        if topic_path and os.path.exists(topic_path):\n",
        "            try: topics = json.load(open(topic_path, 'r', encoding='utf-8'))\n",
        "            except: pass\n",
        "\n",
        "        if 'published_at' in df.columns:\n",
        "            df['published_at'] = pd.to_datetime(df['published_at'], errors='coerce')\n",
        "\n",
        "    except Exception as e:\n",
        "        print(f\"❌ Error loading data: {e}\")\n",
        "        return\n",
        "\n",
        "    # --- EXECUTIVE SUMMARY PRINT ---\n",
        "    print(\"\\n\" + \"=\"*80)\n",
