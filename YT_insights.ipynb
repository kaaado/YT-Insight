        "# ==========================================\n",
        "# 📦 MODULE 4\n",
        "# ==========================================\n",
        "\n",
        "import os\n",
        "import torch\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import accuracy_score, f1_score\n",
        "from transformers import (\n",
        "    AutoTokenizer,\n",
        "    AutoModelForSequenceClassification,\n",
        "    TrainingArguments,\n",
        "    Trainer\n",
        ")\n",
        "\n",
        "# --- CONFIG ---\n",
        "INPUT_FILE = \"data/predictions/comments_classified.parquet\"\n",
        "MODELS_DIR = \"data/saved_models\"\n",
        "BASE_MODEL = \"distilbert-base-multilingual-cased\"\n",
        "\n",
        "class YoutubeDataset(torch.utils.data.Dataset):\n",
        "    def __init__(self, encodings, labels):\n",
        "        self.encodings = encodings\n",
        "        self.labels = labels\n",
        "    def __getitem__(self, idx):\n",
        "        item = {key: torch.tensor(val[idx]) for key, val in self.encodings.items()}\n",
        "        item['labels'] = torch.tensor(self.labels[idx], dtype=torch.float)\n",
        "        return item\n",
        "    def __len__(self): return len(self.labels)\n",
        "\n",
        "def compute_metrics(pred):\n",
        "    labels = pred.label_ids\n",
        "    preds = pred.predictions\n",
        "    preds = (1 / (1 + np.exp(-preds))) > 0.5\n",
        "    f1 = f1_score(labels, preds, average='micro')\n",
        "    acc = accuracy_score(labels, preds)\n",
        "    return {'accuracy': acc, 'f1': f1}\n",
        "\n",
        "def train_multilabel_model(df):\n",
        "    print(\"\\n🎓 TASK: Fine-Tuning Multilingual Neural Network...\")\n",
        "\n",
        "    target_cols = ['is_question', 'is_spam', 'is_supportive']\n",
        "    for t in target_cols:\n",
        "        if t not in df.columns: df[t] = 0\n",
        "        df[t] = df[t].fillna(0).astype(int)\n",
        "\n",
        "    labels = df[target_cols].values.tolist()\n",
        "    texts = df['clean_text_ml'].astype(str).tolist()\n",
        "\n",
        "    print(f\"   🔹 Tokenizing {len(texts)} samples...\")\n",
        "    tokenizer = AutoTokenizer.from_pretrained(BASE_MODEL)\n",
        "\n",
        "    train_texts, val_texts, train_labels, val_labels = train_test_split(texts, labels, test_size=0.2, random_state=42)\n",
        "    train_enc = tokenizer(train_texts, truncation=True, padding=True, max_length=128)\n",
        "    val_enc = tokenizer(val_texts, truncation=True, padding=True, max_length=128)\n",
        "\n",
        "    # Load on CPU explicitly\n",
        "    model = AutoModelForSequenceClassification.from_pretrained(\n",
        "        BASE_MODEL,\n",
        "        num_labels=len(target_cols),\n",
        "        problem_type=\"multi_label_classification\",\n",
        "        low_cpu_mem_usage=False\n",
        "    )\n",
        "\n",
        "    # Trainer will automatically handle moving this CPU model to GPU\n",
        "    args = TrainingArguments(\n",
        "        output_dir=f\"{MODELS_DIR}/checkpoints\",\n",
        "        eval_strategy=\"epoch\",\n",
        "        save_strategy=\"epoch\",\n",
        "        learning_rate=2e-5,\n",
        "        per_device_train_batch_size=16,\n",
        "        per_device_eval_batch_size=16,\n",
        "        num_train_epochs=3,\n",
        "        weight_decay=0.01,\n",
        "        logging_steps=50,\n",
        "        fp16=torch.cuda.is_available(),\n",
        "        use_cpu=not torch.cuda.is_available(),\n",
        "        load_best_model_at_end=True,\n",
        "        metric_for_best_model=\"f1\"\n",
        "    )\n",
        "\n",
        "    trainer = Trainer(\n",
        "        model=model,\n",
        "        args=args,\n",
        "        train_dataset=YoutubeDataset(train_enc, train_labels),\n",
        "        eval_dataset=YoutubeDataset(val_enc, val_labels),\n",
        "        compute_metrics=compute_metrics\n",
        "    )\n",
        "\n",
        "    print(\"   🚀 Starting Training...\")\n",
        "    trainer.train()\n",
        "\n",
        "    final_path = f\"{MODELS_DIR}/yt_insight_finetuned_v1\"\n",
        "    trainer.save_model(final_path)\n",
        "    tokenizer.save_pretrained(final_path)\n",
        "    print(f\"\\n   ✅ Model Saved: {final_path}\")\n",
        "\n",
        "def execute_module_4():\n",
        "    try:\n",
        "        print(\"\\n--- 4. MODEL FINE-TUNING ---\")\n",
        "        if not os.path.exists(INPUT_FILE): raise FileNotFoundError(f\"❌ Input {INPUT_FILE} not found.\")\n",
        "\n",
        "        df = pd.read_parquet(INPUT_FILE)\n",
        "        df = df[df['clean_text_ml'].str.len() > 5].copy()\n",
        "\n",
        "        if len(df) < 20:\n",
        "            print(\"⚠️ Not enough data to train (Need > 20 samples).\")\n",
        "            return\n",
        "        if 'is_supportive' not in df.columns and 'sentiment' in df.columns:\n",
        "             df['is_supportive'] = (df['sentiment'] == 'positive')\n",
        "        print(f\"📊 Training Data: {len(df)} samples\")\n",
        "        train_multilabel_model(df)\n",
        "        print(f\"✅ MODULE 4 COMPLETE.\")\n",
        "    except Exception as e:\n",
        "        print(f\"❌ MODULE 4 ERROR: {e}\")\n"
      ]
